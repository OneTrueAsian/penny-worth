# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Rust build output (workspace-level — core + src-tauri share this one dir)
/target

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
Thumbs.db
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Real transaction data / database backups — this folder has held real
# bank exports before; ignore everything dropped in here by default and
# only allow back in the known-safe synthetic fixtures used for manual
# testing. A real export added later stays untracked automatically.
data/incoming/*
!data/incoming/.gitkeep
!data/incoming/sample.csv
!data/incoming/sample_month2.csv
db-backups/

# Code-signing material — never commit a private key/certificate
*.pfx
*.p12
*.pem
*.key
